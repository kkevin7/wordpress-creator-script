# ============================================================
#  WordPress Site Creator — Environment Variables
# ============================================================
#
#  This file is automatically loaded by create-wordpress.sh
#  when it exists in the same directory as the script.
#
#  Variables defined here will be used directly — the script
#  will NOT prompt for them interactively.
#
#  NOTE: The database NAME is always required interactively
#        and is never loaded from this file. This is by design
#        to prevent accidental overwriting of existing databases.
#
#  Usage:
#    1. Fill in your values below.
#    2. Run: sudo ./create-wordpress.sh
#
# ============================================================

# ── Database connection ──────────────────────────────────────
DB_USER="wp_user"
DB_PASS="your_secure_password_here"
DB_HOST="localhost"
DB_PREFIX="wp_"

# ── MySQL / MariaDB root access (for automatic DB creation) ──
# If set, the script will create the database without prompting
# for root credentials. Leave commented out to be prompted.
# MYSQL_ROOT_USER="root"
# MYSQL_ROOT_PASS="your_root_password_here"
